# ════════════════════════════════════════════════════════════════
# 师傅来了 · 服务端环境变量（复制为 .env 后填入真实值）
# 说明：本文件为模板，真实 .env 请勿提交到版本库。
# ════════════════════════════════════════════════════════════════

# ── 表层轻量 Agent 的真实 LLM（OpenAI 兼容接口）────────────────────
# 不填则回落到内置 Mock 引擎（确定性演示文本）。填了即启用真实大模型。
# 支持任意 OpenAI 兼容端点：OpenAI / DeepSeek / 通义千问 / 智谱 / 月之暗面 / 本地 vLLM 等。
LLM_API_KEY=sk-your-real-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── 重度执行 Agent 底座（可插拔：换底座只改这里）──────────────────
HEAVY_AGENT_TASK_ENDPOINT=http://127.0.0.1:8310/agent/tasks

# ── 微信社会化登录（OAuth2，可选）──────────────────────────────────
# 留空即走「演示模式」：授权直接回跳，无需真实公众号即可联调登录态/头像/昵称。
WECHAT_APPID=
WECHAT_APPSECRET=
WECHAT_REDIRECT_URI=http://127.0.0.1:8300/auth/wechat/callback

# ── 数据库备份（结构 + 全量；代码修订回滚安全网的一侧）──────────────
# 备份目录：结构(.schema.sql) 与 全量(.db) 成对存放，并附 .json 元信息。
DB_BACKUP_DIR=server/data/db_backups
# 保留份数（全量 + 结构合并计算，超出按时间 FIFO 删除最旧）。
# 默认 20；被「收藏」(pinned) 的备份永不被自动清理。
DB_BACKUP_KEEP=20
# 每日自动全量备份（后台任务，随服务启动）；false 关闭。
DB_BACKUP_AUTODAILY=true
